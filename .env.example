# Name: Aryan Zope
# PRN: 26070122053
#
# Copy this file to .env (already in .gitignore, so it's never committed) and
# fill in real values there. Never paste a real key into app.py or any
# tracked file -- and never paste one into a chat window either, since it
# then has to be treated as exposed and rotated.

# Flask session signing key and the HMAC salt used to pseudonymize student IDs.
TRUSTLEARN_SECRET=change-me-to-a-long-random-string
TRUSTLEARN_SALT=change-me-too

# Key used to encrypt chat/notes at rest (cryptography.fernet). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, the app generates a temporary one each run (data won't survive a restart).
TRUSTLEARN_FERNET_KEY=

# AI tutor / summarizer. app.py calls this as an OpenAI-style chat-completions
# endpoint. If your provider's request/response shape differs (Anthropic and
# Gemini both do), adjust call_ai_api() in app.py to match.
TRUSTLEARN_AI_API_KEY=
TRUSTLEARN_AI_BASE_URL=https://api.openai.com/v1/chat/completions
TRUSTLEARN_AI_MODEL=gpt-4o-mini
